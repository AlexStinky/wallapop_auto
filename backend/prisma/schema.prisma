generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  description  String
  price        Float
  category     String
  subcategory  String?
  condition    String
  brand        String?
  color        String?
  weight       String?
  quantity     Int      @default(1)
  images       String   // JSON array of file paths
  status       String   @default("pending") // pending|in_queue|publishing|published|error
  wallapopId   String?
  wallapopUrl  String?
  errorMessage String?
  queueOrder   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  wallapopEmail    String  @default("")
  wallapopPassword String  @default("")
  publishDelay     Int     @default(30)
  headless         Boolean @default(true)
}
